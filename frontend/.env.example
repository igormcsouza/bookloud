# Base URL of the Bookloud backend API.
# Dev: the local backend (docker-compose). Prod/PR: the deployed HTTP API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cognito config for the server-side BFF route handlers (app/api/auth/*).
# Deliberately NOT NEXT_PUBLIC_* -- read at runtime only, on the server, by
# lib/cognito.ts; never baked into the client bundle. In AWS these come from
# infra/stacks/frontend_stack.py; locally, make ui reads local/.cognito.env
# (written by local/cognito_bootstrap.py) for COGNITO_CLIENT_ID.
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_ENDPOINT=http://localhost:9229

# Same value/semantics as the backend's Settings.environment: gates whether
# email is required at signup (prod only) -- see app/signup/page.tsx and
# app/api/auth/signup/route.ts.
ENVIRONMENT=local
