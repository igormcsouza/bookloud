{
  "name": "mobile",
  "version": "0.3.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --port 18541",
    "android": "expo start --android --port 18541",
    "ios": "expo start --ios --port 18541",
    "web": "expo start --web --port 18541",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
