# Copy to .env and fill in for your environment.

# Local docker backend: http://<your-LAN-IP>:8000 (a phone can't reach
# localhost on your machine). Deployed pr-N/staging/prod: the API Gateway
# URLs from that stack's CDK outputs (ApiUrl / ChatUrl).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_CHAT_BASE_URL=http://localhost:8001

EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REGION=us-east-1
# Overridden locally to point at cognito-local instead of real AWS.
EXPO_PUBLIC_COGNITO_ENDPOINT=
