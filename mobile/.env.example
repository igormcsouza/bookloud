# Copy to .env and fill in for your environment.

# Local docker backend: http://<your-LAN-IP>:18540 for a physical phone (a
# phone can't reach localhost on your machine); http://10.0.2.2:18540 for
# the Android emulator instead (its NAT'd network can't reach localhost OR
# your real LAN-IP -- 10.0.2.2 is its fixed alias for the host loopback; see
# README's "Running against the Android emulator", and set S3_PUBLIC_HOST
# the same way or PDF upload/delete calls will 500). Deployed
# pr-N/staging/prod: the API Gateway URLs from that stack's CDK outputs
# (ApiUrl / ChatUrl).
EXPO_PUBLIC_API_BASE_URL=http://localhost:18540
EXPO_PUBLIC_CHAT_BASE_URL=http://localhost:18542

EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REGION=us-east-1
# Overridden locally to point at cognito-local (http://<your-LAN-IP>:18543,
# or http://10.0.2.2:18543 for the Android emulator) instead of real AWS.
EXPO_PUBLIC_COGNITO_ENDPOINT=
