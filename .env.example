# Root-level env reference for local dev. docker-compose.yml sets these for
# you; this file documents them for anything run outside compose (e.g. `cdk
# synth`, ad-hoc scripts).

# AWS region every stack deploys into (see infra/stacks/config.py).
AWS_REGION=us-east-1

# Drives resource naming across every stack: "dev" locally, "pr-<N>" for
# ephemeral PR environments, "staging"/"prod" in CD.
ENVIRONMENT=local

# Cognito emulation (jagregory/cognito-local) for local dev. `make up` runs
# local/cognito_bootstrap.py, which creates the pool/client/dev user and
# writes the generated ids to local/.cognito.env (gitignored). This is the
# host-reachable port from docker-compose.yml's port mapping; the mobile
# app's own env vars live in mobile/.env.example instead.
COGNITO_ENDPOINT_URL=http://localhost:18543
COGNITO_REGION=us-east-1
